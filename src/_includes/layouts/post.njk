---
layout: layouts/base.njk
---
{%- set previousPost = collections.posts | getNextCollectionItem(page) %}
{%- set nextPost = collections.posts | getPreviousCollectionItem(page) %}
<article class="container post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    {%- if description %}<p class="lede">{{ description }}</p>{% endif %}
    <p class="post-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true">·</span>
      <span>{{ content | readingTime }}</span>
      {%- if draft %}<span class="tag tag-draft">Draft</span>{% endif %}
    </p>
    {%- if tags and tags.length %}
    <ul class="tag-list" aria-label="Tags">
      {%- for tag in tags %}{% if tag != "posts" %}<li class="tag">{{ tag }}</li>{% endif %}{% endfor %}
    </ul>
    {%- endif %}
  </header>

  <div class="prose">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <aside class="author-card">
      <img src="/assets/images/headshot.jpg" alt="" width="64" height="80" loading="lazy">
      <p>Written by <a href="/about/">{{ site.name }}</a>. Questions or thoughts? <a href="/contact/">Send me a note</a>.</p>
    </aside>
    {%- if previousPost or nextPost %}
    <nav class="post-nav" aria-label="More posts">
      {%- if previousPost %}<a class="post-nav-prev" href="{{ previousPost.url }}"><span>Older</span>{{ previousPost.data.title }}</a>{% endif %}
      {%- if nextPost %}<a class="post-nav-next" href="{{ nextPost.url }}"><span>Newer</span>{{ nextPost.data.title }}</a>{% endif %}
    </nav>
    {%- endif %}
  </footer>
</article>
