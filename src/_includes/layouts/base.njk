<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.name) if title and page.url != "/" else (site.name + " · " + site.tagline) %}
  {%- set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)">

  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDescription }}">
  {%- if page.url %}
  <meta property="og:url" content="{{ page.url | htmlBaseUrl(site.url) }}">
  {%- endif %}
  <meta property="og:image" content="{{ '/assets/images/headshot.jpg' | htmlBaseUrl(site.url) }}">
  <meta name="twitter:card" content="summary">

  <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Blog" href="/feed.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Libre+Franklin:wght@500;600;700&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {%- if scripts %}{% for s in scripts %}
  <script src="{{ s }}" defer></script>
  {%- endfor %}{% endif %}
</body>
</html>
